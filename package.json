{
  "name": "@saas-boilerplate/root",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matchy-plus/matchy-plus.git"
  },
  "homepage": "https://github.com/matchy-plus/matchy-plus#readme",
  "bugs": {
    "url": "https://github.com/matchy-plus/matchy-plus/issues"
  },
  "author": "Khalil Bchir (https://github.com/Khalil-Bchir)",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@saas-boilerplate/api...",
    "dev": "pnpm infra:up && dotenv -q -e .env.development -- turbo run dev",
    "dev:web": "dotenv -q -e .env.development -- turbo run dev",
    "dev:ai": "pnpm --filter @saas-boilerplate/ai dev:local",
    "stage": "dotenv -q -e .env.staging -- turbo run stage",
    "staging": "dotenv -q -e .env.staging -- turbo run stage",
    "test": "turbo run test",
    "start": "dotenv -q -e .env.production -- turbo run start",
    "prod": "dotenv -q -e .env.production -- turbo run start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx,vue}\"",
    "clean": "rm -rf node_modules .turbo && turbo run clean",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "git-cz",
    "db:push": "turbo run db:push",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "db:generate": "turbo run db:generate",
    "infra:up": "dotenv -q -e .env.development -- docker compose -f compose.dev.yaml up -d --build redis ai",
    "infra:db": "dotenv -q -e .env.development -- docker compose -f compose.dev.yaml --profile db up -d postgres",
    "infra:down": "dotenv -q -e .env.development -- docker compose -f compose.dev.yaml down",
    "infra:logs": "dotenv -q -e .env.development -- docker compose -f compose.dev.yaml logs -f redis ai",
    "mobile:sync": "pnpm --filter @saas-boilerplate/mobile sync:android",
    "mobile:open": "pnpm --filter @saas-boilerplate/mobile open:android",
    "mobile:dev": "pnpm --filter @saas-boilerplate/mobile dev:remote"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/prompt-cli": "^21.2.0",
    "@saas-boilerplate/eslint-config": "workspace:*",
    "@saas-boilerplate/prettier-config": "workspace:*",
    "@saas-boilerplate/typescript-config": "workspace:*",
    "commitizen": "^4.3.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "inquirer": "^12.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "^2.8.12"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@10.12.4"
}
