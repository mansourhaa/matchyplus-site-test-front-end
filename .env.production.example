# Production template — copy to `.env.production` (gitignored).
# Used by: pnpm start, deploy/scripts/bootstrap-secrets.sh saas-production .env.production

NODE_ENV=production
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
# Required behind Nginx Ingress so request.ip / rate limits / IP geo use X-Forwarded-For.
TRUST_PROXY=true

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-production.svc.cluster.local:5432/saas_production?schema=public

ACCESS_TOKEN_SECRET=production-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1d
COOKIE_SECRET=production-cookie-secret-replace-before-deploy

# Refresh token signing
REFRESH_TOKEN_SECRET=replace-with-a-secure-production-secret
REFRESH_TOKEN_TTL_DAYS=30

# Verification-code HMAC secret — hashes short-lived phone OTP codes; never store the
# plaintext code. Use a different long random value per environment.
VERIFICATION_CODE_SECRET=replace-with-a-secure-production-secret

# TunisieSMS (phone OTP delivery) — optional at startup. The API boots fine without
# this; only phone-OTP endpoints fail at request time with sms_service_not_configured
# (503) until it's set. This app owns the OTP lifecycle itself (see
# services/otp-challenge.ts) — TunisieSMS only sends the text message.
TUNISIESMS_KEY=replace-with-production-tunisiesms-api-key
TUNISIESMS_SENDER=Matchy plus

# Google & LinkedIn OAuth — optional per provider; a missing client id/secret pair
# disables only that provider, it does not stop the API from starting.
API_BASE_URL=https://api.saas-boilerplate.io
FRONTEND_URL=https://saas-boilerplate.io
GOOGLE_CLIENT_ID=replace-with-production-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-production-google-oauth-client-secret
LINKEDIN_CLIENT_ID=replace-with-production-linkedin-oauth-client-id
LINKEDIN_CLIENT_SECRET=replace-with-production-linkedin-oauth-client-secret
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

NEXT_PUBLIC_API_URL=https://api.saas-boilerplate.io/api/v1
CORS_ORIGINS=https://saas-boilerplate.io

# The admin/member session cookies are set by the API (api.*) but the panel/app run on
# the apex domain, so each needs a domain covering both or the browser will not send it
# back to the API.
ADMIN_COOKIE_DOMAIN=.saas-boilerplate.io
MEMBER_COOKIE_DOMAIN=.saas-boilerplate.io

# Prefer a managed Redis in production when HA is required.
# Default points at in-cluster saas-redis Service from deploy/k8s/base/redis.
REDIS_URL=redis://saas-redis.saas-production.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=2
AI_INTERNAL_TOKEN=production-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO
