# Production template — copy to `.env.production` (gitignored).
# Used by: pnpm start, deploy/scripts/bootstrap-secrets.sh saas-production .env.production
#
# Public URLs (Matchy+ production):
#   Landing  https://matchyplus.com
#   App      https://app.matchyplus.com
#   Admin    https://admin.matchyplus.com
#   API      https://api.matchyplus.com

NODE_ENV=production
APP_NAME=Matchy+

SERVER_PORT=8000
SERVER_HOST=0.0.0.0
TRUST_PROXY=true

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-production.svc.cluster.local:5432/saas_production?schema=public

ACCESS_TOKEN_SECRET=production-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1h
COOKIE_SECRET=production-cookie-secret-replace-before-deploy
MOBILE_CLIENT_SECRET=production-mobile-client-secret-replace-before-deploy

REFRESH_TOKEN_SECRET=replace-with-a-secure-production-secret
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_SECRET=replace-with-a-secure-production-secret

TUNISIESMS_KEY=replace-with-production-tunisiesms-api-key
TUNISIESMS_SENDER=Matchy plus
DISABLE_SMS=false

API_BASE_URL=https://api.matchyplus.com
FRONTEND_URL=https://app.matchyplus.com
LANDING_URL=https://matchyplus.com
ADMIN_URL=https://admin.matchyplus.com

GOOGLE_CLIENT_ID=replace-with-production-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-production-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://api.matchyplus.com/api/v1/auth/oauth/google/callback
LINKEDIN_CLIENT_ID=replace-with-production-linkedin-oauth-client-id
LINKEDIN_CLIENT_SECRET=replace-with-production-linkedin-oauth-client-secret
LINKEDIN_REDIRECT_URI=https://api.matchyplus.com/api/v1/auth/oauth/linkedin/callback
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

NEXT_PUBLIC_API_URL=https://api.matchyplus.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.matchyplus.com
NEXT_PUBLIC_LANDING_URL=https://matchyplus.com
# Cap remote-URL mode shares the app host. Local Cap shell also needs:
#   capacitor://localhost,http://localhost,https://localhost

CORS_ORIGINS=https://matchyplus.com,https://app.matchyplus.com,https://admin.matchyplus.com

ADMIN_COOKIE_DOMAIN=.matchyplus.com
MEMBER_COOKIE_DOMAIN=.matchyplus.com

DISCOVERY_RADIUS_M=25000
DISCOVERY_PAGE_SIZE=20

# Early-access waitlist → Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=
GOOGLE_SHEETS_RANGE=
GOOGLE_SHEETS_FEEDBACK_TAB=
GOOGLE_SHEETS_FEEDBACK_RANGE=
FEEDBACK_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=

REDIS_URL=redis://saas-redis.saas-production.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
REALTIME_STREAM_KEY=realtime:events
# Prefer StatefulSet pod name via Downward API (deploy/k8s/base/api/statefulset.yaml)
# INSTANCE_ID=saas-api-0
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=2
AI_INTERNAL_TOKEN=production-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO

KONNECT_SANDBOX=false

# Optional SMTP for notification emails (omit to disable).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Matchy+ <no-reply@example.com>
# SMTP_SECURE=true
# SMTP_FROM_NAME=Matchy+
