# Staging template — copy to `.env.staging` (gitignored).
# Used by: pnpm stage, deploy/scripts/bootstrap-secrets.sh saas-staging .env.staging
#
# Public URLs (Matchy+ staging):
#   Landing  https://staging.matchyplus.com
#   App      https://app.staging.matchyplus.com
#   Admin    https://admin.staging.matchyplus.com
#   API      https://api.staging.matchyplus.com

NODE_ENV=staging
APP_NAME=Matchy+

SERVER_PORT=8000
SERVER_HOST=0.0.0.0
TRUST_PROXY=true

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-staging.svc.cluster.local:5432/saas_staging?schema=public

ACCESS_TOKEN_SECRET=staging-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1h
COOKIE_SECRET=staging-cookie-secret-replace-before-deploy
MOBILE_CLIENT_SECRET=staging-mobile-client-secret-replace-before-deploy

REFRESH_TOKEN_SECRET=change-me-to-a-long-random-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_SECRET=change-me-to-another-long-random-secret

TUNISIESMS_KEY=change-me-to-your-tunisiesms-api-key
TUNISIESMS_SENDER=Matchy plus
DISABLE_SMS=false

API_BASE_URL=https://api.staging.matchyplus.com
FRONTEND_URL=https://app.staging.matchyplus.com
LANDING_URL=https://staging.matchyplus.com
ADMIN_URL=https://admin.staging.matchyplus.com

GOOGLE_CLIENT_ID=change-me-to-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=change-me-to-your-google-oauth-client-secret
LINKEDIN_CLIENT_ID=change-me-to-your-linkedin-oauth-client-id
LINKEDIN_CLIENT_SECRET=change-me-to-your-linkedin-oauth-client-secret
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

NEXT_PUBLIC_API_URL=https://api.staging.matchyplus.com/api/v1
# Cap remote-URL mode shares the app host. Local Cap shell also needs:
#   capacitor://localhost,http://localhost,https://localhost

CORS_ORIGINS=https://staging.matchyplus.com,https://app.staging.matchyplus.com,https://admin.staging.matchyplus.com

ADMIN_COOKIE_DOMAIN=.staging.matchyplus.com
MEMBER_COOKIE_DOMAIN=.staging.matchyplus.com

DISCOVERY_RADIUS_M=25000
DISCOVERY_PAGE_SIZE=20

# Early-access waitlist → Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=
GOOGLE_SHEETS_RANGE=
GOOGLE_SHEETS_FEEDBACK_TAB=
GOOGLE_SHEETS_FEEDBACK_RANGE=
FEEDBACK_ENABLED=
GOOGLE_SERVICE_ACCOUNT_JSON=

REDIS_URL=redis://saas-redis.saas-staging.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
REALTIME_STREAM_KEY=realtime:events
# Prefer StatefulSet pod name via Downward API (deploy/k8s/base/api/statefulset.yaml)
# INSTANCE_ID=saas-api-0
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=1
AI_INTERNAL_TOKEN=staging-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO

KONNECT_SANDBOX=true

# Optional SMTP for notification emails (omit to disable).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Matchy+ <no-reply@example.com>
# SMTP_SECURE=false
# SMTP_FROM_NAME=Matchy+
