# Staging template — copy to `.env.staging` (gitignored).
# Used by: pnpm stage, deploy/scripts/bootstrap-secrets.sh saas-staging .env.staging

NODE_ENV=staging
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-staging.svc.cluster.local:5432/saas_staging?schema=public

ACCESS_TOKEN_SECRET=staging-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1d
COOKIE_SECRET=staging-cookie-secret-replace-before-deploy

# Refresh token signing
REFRESH_TOKEN_SECRET=change-me-to-a-long-random-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30

# Twilio Verify
TWILIO_ACCOUNT_SID=change-me-to-your-twilio-account-sid
TWILIO_AUTH_TOKEN=change-me-to-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=change-me-to-your-twilio-verify-service-sid

# Google & LinkedIn OAuth — optional per provider; a missing client id/secret pair
# disables only that provider, it does not stop the API from starting.
API_BASE_URL=https://api.staging.saas-boilerplate.io
FRONTEND_URL=https://staging.saas-boilerplate.io
GOOGLE_CLIENT_ID=change-me-to-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=change-me-to-your-google-oauth-client-secret
LINKEDIN_CLIENT_ID=change-me-to-your-linkedin-oauth-client-id
LINKEDIN_CLIENT_SECRET=change-me-to-your-linkedin-oauth-client-secret
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

NEXT_PUBLIC_API_URL=https://api.staging.saas-boilerplate.io/api/v1
CORS_ORIGINS=https://staging.saas-boilerplate.io

# The admin session cookie is set by the API (api.staging.*) but the panel runs on staging.*,
# so it needs a domain covering both or the browser will not send it back to the API.
ADMIN_COOKIE_DOMAIN=.staging.saas-boilerplate.io

# In-cluster Redis (deploy/k8s/base/redis). Replace with managed Redis URL if preferred.
REDIS_URL=redis://saas-redis.saas-staging.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=1
AI_INTERNAL_TOKEN=staging-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO
