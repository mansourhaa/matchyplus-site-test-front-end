{
  "name": "@saas-boilerplate/app",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.tsx"
  },
  "scripts": {
    "dev": "dotenv -q -e ../../.env.development -- next dev",
    "stage": "dotenv -q -e ../../.env.staging -- next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "dotenv -q -e ../../.env.production -- next build",
    "start": "dotenv -q -e ../../.env.production -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@saas-boilerplate/ui": "workspace:*",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.3.0",
    "recharts": "^3.9.2",
    "redux-persist": "^6.0.0",
    "reselect": "^5.2.0",
    "sonner": "^2.0.7",
    "three": "^0.185.1",
    "three-globe": "^2.45.2",
    "video.js": "^8.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
