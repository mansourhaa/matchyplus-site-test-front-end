# Remote WebView URL for the Next.js member app (apps/app).
# Android emulator → host machine: http://10.0.2.2:3000
# Physical device on the same LAN: http://192.168.x.x:3000
# Staging: https://app.staging.matchyplus.com
# Production: https://app.matchyplus.com
CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Mobile client secret & deep link scheme (must match API config)
MOBILE_CLIENT_SECRET=dev-mobile-client-secret
MOBILE_APP_SCHEME=matchy
