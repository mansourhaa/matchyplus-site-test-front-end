# Copy to keystore.properties (gitignored) next to this file's parent (android/).
# Never commit real passwords.

storeFile=matchy-release.keystore
storePassword=
keyAlias=matchy
keyPassword=

# Same value as API MOBILE_CLIENT_SECRET — baked into BuildConfig for MobileClient plugin.
mobileClientSecret=
# Optional per-environment overrides
mobileClientSecret_development=dev-mobile-client-secret
mobileClientSecret_staging=staging-mobile-client-secret-replace-before-deploy
mobileClientSecret_production=production-mobile-client-secret-replace-before-deploy
