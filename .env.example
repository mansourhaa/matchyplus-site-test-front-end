# Copy to `.env.development`, `.env.staging`, or `.env.production` and set real values.
# Never commit files with secrets — only the `*.example` templates are tracked in git.
#
# Templates:
#   .env.example            → development
#   .env.staging.example    → staging
#   .env.production.example → production
#
# Repository: https://github.com/matchy-plus/matchy-plus
# See doc/setup/environments-and-node-env.md for how env loading works.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Runtime environment: development | staging | production
NODE_ENV=development

# Product name (display / emails)
APP_NAME=Matchy+

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

SERVER_PORT=8000
SERVER_HOST=localhost
# Set true only behind a trusted reverse proxy (required in staging/production K8s).
TRUST_PROXY=false

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db?schema=public

# Optional compose.dev.yaml overrides (profile: db) — include in `.env.development`
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Authentication & sessions
# ---------------------------------------------------------------------------

# JWT access token signing (use a long random string in production)
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=1h

# Verification-code HMAC secret — hashes phone OTP codes (see services/otp-challenge.ts)
VERIFICATION_CODE_SECRET=change-me-to-another-long-random-secret

# Refresh token signing
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-secret
REFRESH_TOKEN_TTL_DAYS=30

# Cookie signing secret (recommended for production)
COOKIE_SECRET=change-me-to-a-long-random-secret

# Optional OTP lifecycle tuning (defaults apply if unset)
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_SIGNUP_GRANT_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# SMS (TunisieSMS) — optional at startup
# ---------------------------------------------------------------------------

# The API boots without TUNISIESMS_KEY; phone-OTP endpoints return 503 until set.
TUNISIESMS_KEY=change-me-to-your-tunisiesms-api-key
# TUNISIESMS_SENDER=Matchy plus
# Legacy TunisieSMS fields (not used by the Fastify API — kept for migration reference)
# TUNISIESMS_USER=
# TUNISIESMS_PASS=
# TUNISIESMS_API_URL=https://api.l2t.io/tn/v0/api/api.aspx

# Skip real SMS in dev; OTP code is returned in the API response as devCode instead.
DISABLE_SMS=true

# ---------------------------------------------------------------------------
# OAuth (Google & LinkedIn) — optional per provider
# ---------------------------------------------------------------------------

# Absolute API base (OAuth callback URLs are derived from this + /api/v1/auth/oauth/…)
API_BASE_URL=http://localhost:8000
# Member Next.js app (OAuth redirect target after code exchange).
# Notification email CTAs also resolve APP_URL → FRONTEND_URL → PUBLIC_APP_URL (first set wins);
# if none are set, emails fall back to http://localhost:3000.
FRONTEND_URL=http://localhost:3000
# APP_URL=
# PUBLIC_APP_URL=
# Marketing site (landing) — used for CORS / documentation
LANDING_URL=http://localhost:3002
# Admin panel
ADMIN_URL=http://localhost:3001

# GOOGLE_CLIENT_ID=change-me-to-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=change-me-to-your-google-oauth-client-secret
# LINKEDIN_CLIENT_ID=change-me-to-your-linkedin-oauth-client-id
# LINKEDIN_CLIENT_SECRET=change-me-to-your-linkedin-oauth-client-secret
# OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Next.js frontends — public build-time vars (never put secrets here)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Landing-only: skip API calls (offline UI testing)
# NEXT_PUBLIC_DISABLE_API=false

# Cookie domains — only needed when API and frontends are on different subdomains.
ADMIN_COOKIE_DOMAIN=
MEMBER_COOKIE_DOMAIN=

# Admin accounts created by the development seed (demo fallback when NODE_ENV=development)
SEED_SUPER_ADMIN_PASSWORD=
SEED_MODERATOR_PASSWORD=

# Comma-separated browser / Capacitor WebView origins (CORS + origin guard).
# May be empty only in development. Include landing (:3002), app (:3000), admin (:3001).
# Cap remote-URL mode uses the same app host as web. Local Cap shell (no server.url) also needs:
#   capacitor://localhost,http://localhost,https://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---------------------------------------------------------------------------
# Matching / discovery
# ---------------------------------------------------------------------------

DISCOVERY_RADIUS_M=25000
DISCOVERY_PAGE_SIZE=20
# DISCOVERY_SIM_MIN=0.65

# ---------------------------------------------------------------------------
# Location proxies
# ---------------------------------------------------------------------------

# NOMINATIM_USER_AGENT=MatchyPlus/1.0 (contact@matchyplus.com)
# IP_GEOLOCATION_TIMEOUT_MS=5000
# REVERSE_GEOCODE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Early-access waitlist → Google Sheets (optional)
# ---------------------------------------------------------------------------

# A) Apps Script / Zapier webhook (easiest):
# GOOGLE_SHEETS_WEBHOOK_URL=
# B) Service account (share the spreadsheet with the SA email as Editor):
# GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab chosen from NODE_ENV: development → dev | staging → staging | production → prod
# GOOGLE_SHEETS_TAB=
# GOOGLE_SHEETS_RANGE=
# GOOGLE_SHEETS_FEEDBACK_TAB=
# GOOGLE_SHEETS_FEEDBACK_RANGE=
# FEEDBACK_ENABLED=
# Raw JSON or base64 of the service-account key file
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Mobile (Capacitor — apps/mobile)
# ---------------------------------------------------------------------------

# Remote dev URL for the native shell (e.g. Android emulator → host):
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# ---------------------------------------------------------------------------
# Option C — async AI (Redis queue + Flask worker)
# Local: docker compose -f compose.dev.yaml up -d redis ai
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=1
AI_INTERNAL_TOKEN=dev-ai-internal-token
# DB URL seen from the AI Docker container (host Postgres)
# AI_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/saas_db?schema=public
LOG_LEVEL=INFO

# Multi-instance WebSocket fan-out (same Redis). Required + unique per replica when REDIS_URL is set.
REALTIME_STREAM_KEY=realtime:events
INSTANCE_ID=api-local

# Optional SMTP for notification emails (omit to disable mail delivery).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Matchy+ <no-reply@example.com>
# SMTP_SECURE=false
# SMTP_FROM_NAME=Matchy+
# SMTP_LOGO_PATH=

# Optional: graceful shutdown delay in ms (default: 500)
# FASTIFY_CLOSE_GRACE_DELAY=500

# ---------------------------------------------------------------------------
# Payments (Konnect) — not yet wired in the Fastify API; kept from legacy Matchy+
# ---------------------------------------------------------------------------

# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# KONNECT_SANDBOX=true
# KONNECT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Legacy AI / matching (Matchy-FullStack — not used by this monorepo yet)
# ---------------------------------------------------------------------------

# AI_MATCHING_URL=http://localhost:8001
# USE_AI_MATCHING=false
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=mxbai-embed-large
