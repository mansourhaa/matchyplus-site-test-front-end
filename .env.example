# Copy to `.env.development`, `.env.staging`, or `.env.production` and set real values.
# Never commit files with secrets — only the `*.example` templates are tracked in git.
#
# Templates:
#   .env.example            → development
#   .env.staging.example    → staging
#   .env.production.example → production
#
# Repository: https://github.com/matchy-plus/matchy-plus
# See doc/setup/environments-and-node-env.md for how env loading works.

# Runtime environment: development | staging | production
NODE_ENV=development

# API server
SERVER_PORT=8000
SERVER_HOST=localhost

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db?schema=public

# JWT access token signing (use a long random string in production)
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=1d

# Verification-code HMAC secret
# Used to hash short-lived email verification codes without storing plaintext.
# Use a different long random value in each environment.
VERIFICATION_CODE_SECRET=change-me-to-another-long-random-secret

# Refresh token signing
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-secret
REFRESH_TOKEN_TTL_DAYS=30
# Cookie signing secret (recommended for production)
COOKIE_SECRET=change-me-to-a-long-random-secret

# Twilio Verify (phone OTP) — required for SMS verification flows
# Put the values from your Twilio Console here:
# - TWILIO_ACCOUNT_SID: your Twilio Account SID
# - TWILIO_AUTH_TOKEN: your Twilio Auth Token
# - TWILIO_VERIFY_SERVICE_SID: the SID of your Twilio Verify service
TWILIO_ACCOUNT_SID=change-me-to-your-twilio-account-sid
TWILIO_AUTH_TOKEN=change-me-to-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=change-me-to-your-twilio-verify-service-sid

# Email (SMTP) — optional. Only needed for email verification. When unset, the
# server still boots; POST /auth/email-verification/request just fails at request
# time with smtp_not_configured (503) instead of sending a code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=change-me-to-a-real-smtp-password
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Matchy+
# SMTP_SECURE=false

# Google & LinkedIn OAuth — each provider is optional and independent: the server
# still boots with either (or both) unset, and only that provider's /oauth/<name>
# route is unavailable (its @fastify/oauth2 instance is never registered).
# API_BASE_URL and FRONTEND_URL are used to build the absolute OAuth callback URL and
# the SPA redirect target, respectively.
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=change-me-to-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=change-me-to-your-google-oauth-client-secret
# LINKEDIN_CLIENT_ID=change-me-to-your-linkedin-oauth-client-id
# LINKEDIN_CLIENT_SECRET=change-me-to-your-linkedin-oauth-client-secret
# Optional: how long an OAuth exchange code stays valid (default: 60)
# OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

# Next.js frontend — public API base URL (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Option C — async AI (Redis queue + Flask worker + optional cache)
# Local: docker compose -f compose.dev.yaml up -d redis ai
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=1
AI_INTERNAL_TOKEN=dev-ai-internal-token
LOG_LEVEL=INFO

# Optional: graceful shutdown delay in ms (default: 500)
# FASTIFY_CLOSE_GRACE_DELAY=500
