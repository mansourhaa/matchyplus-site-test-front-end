{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "NEXT_PUBLIC_API_URL",
    "REDIS_URL",
    "AI_STREAM_KEY",
    "AI_CONSUMER_GROUP",
    "AI_CACHE_TTL_SECONDS",
    "REALTIME_STREAM_KEY",
    "INSTANCE_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "../types/src/generated/**"]
    },
    "build:api": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["dist/**", "!dist/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", ".eslintrc*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "format": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "^db:generate"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development.local",
        ".env.local",
        ".env.development"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production"
      ]
    },
    "stage": {
      "dependsOn": ["^build", "^db:generate"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.staging.local",
        ".env.local",
        ".env.staging"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "**/*.test.tsx", "vitest.config.*"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": ["../types/src/generated/**"]
    },
    "db:push": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "db:reset": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    }
  }
}
