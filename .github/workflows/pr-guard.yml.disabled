name: PR Guard

# Soft topology checks for the org PR flow. Mark these as required status
# checks on protected branches once GitHub Team (or equivalent) is enabled.
# See doc/setup/branch-protection.md.

on:
  pull_request:
    types: [opened, edited, reopened, synchronize]
    branches: [dev, staging, main]

concurrency:
  group: pr-guard-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  topology:
    name: Enforce branch topology
    runs-on: ubuntu-latest
    steps:
      - name: Validate base ← head
        env:
          BASE: ${{ github.base_ref }}
          HEAD: ${{ github.head_ref }}
        run: |
          set -euo pipefail

          echo "PR target: ${HEAD} → ${BASE}"

          case "${BASE}" in
            main)
              if [ "${HEAD}" != "staging" ]; then
                echo "::error::Production promotions must be staging → main (got ${HEAD} → ${BASE})."
                echo "Feature/fix work must target dev. See doc/setup/pr-and-merge-flow.md"
                exit 1
              fi
              ;;
            staging)
              if [ "${HEAD}" != "dev" ]; then
                echo "::error::Staging promotions must be dev → staging (got ${HEAD} → ${BASE})."
                exit 1
              fi
              ;;
            dev)
              if [[ "${HEAD}" =~ ^(main|staging|dev)$ ]]; then
                echo "::error::Do not open ${HEAD} → ${BASE}. Use promotion PRs for environment hops."
                exit 1
              fi
              if [[ ! "${HEAD}" =~ ^(feature|fix|chore|docs|refactor|test|ci|build|perf|style|revert)/ ]]; then
                echo "::warning::Prefer conventional branch names: feature/*, fix/*, chore/*, docs/*, etc. (got ${HEAD})"
              fi
              ;;
            *)
              echo "::error::Unexpected base branch: ${BASE}"
              exit 1
              ;;
          esac

          echo "Topology OK."
