generator client {
  provider = "prisma-client"
  output   = "../../types/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  phone         String?  @unique
  password      String?  @db.Text()
  auth_provider String   @default("email")
  create_at     DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  email_verified                Boolean        @default(false)
  pending_email                 String?
  email_verification_code       String?
  email_verification_expires_at DateTime?
  aiJobs                        AiJob[]
  refresh_tokens                RefreshToken[]

  @@index([email])
  @@index([phone])
}

model RefreshToken {
  id         String    @id
  token_hash String    @unique @db.Text()
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked_at DateTime?
  create_at  DateTime  @default(now())

  @@index([user_id])
}

enum AiJobType {
  ANALYZE_VIDEO
  VERIFY_IDENTITY
  EMBED
  MATCH
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Durable AI job record. Redis Streams is the queue transport;
/// this table is the source of truth for status polling and audits.
model AiJob {
  id             String      @id @default(cuid())
  type           AiJobType
  status         AiJobStatus @default(QUEUED)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKey String?     @unique
  payload        Json
  result         Json?
  error          String?     @db.Text
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3)
  queuedAt       DateTime    @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, status])
}
