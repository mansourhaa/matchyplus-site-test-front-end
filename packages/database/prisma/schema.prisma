generator client {
  provider = "prisma-client"
  output   = "../../types/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPPORT
  MODERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserPlan {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

/// Treatment state of a profile report, from filed to handled by an admin.
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

/// Plan configuration edited from the admin "Gestion Forfaits" section. The id mirrors
/// `UserPlan` so a user's plan resolves to exactly one row.
model Plan {
  id          UserPlan @id
  name        String
  price       Float    @default(0)
  color       String   @default("#888888")
  is_active   Boolean  @default(true)
  badge       String   @default("")
  trial_days  Int      @default(0)
  description String   @default("")
  features    String[] @default([])

  // Limits: -1 means unlimited.
  swipes_per_day           Int @default(-1)
  profiles_per_category    Int @default(-1)
  messages_per_day         Int @default(-1)
  actions_per_day          Int @default(-1)
  boosts_per_month         Int @default(0)
  super_connects_per_month Int @default(0)

  sort_order Int      @default(0)
  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String @db.Text()
  role     Role   @default(USER)

  // Profile fields surfaced by the admin panel.
  status         UserStatus @default(ACTIVE)
  plan           UserPlan   @default(FREE)
  phone          String?
  job            String?
  category       String?
  city           String?
  bio            String?    @db.Text()
  image          String?    @db.Text()
  interests      String[]   @default([])
  languages      String[]   @default([])
  contact_modes  String[]   @default([])
  experience     String?
  schedule       String?
  price          String?
  rating         Float      @default(0)
  reviews        Int        @default(0)
  matches        Int        @default(0)
  missions       Int        @default(0)
  total_earnings Int        @default(0)
  last_login     DateTime?

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  aiJobs     AiJob[]

  reports_made     Report[] @relation("ReportsMade")
  reports_received Report[] @relation("ReportsReceived")

  @@index([email])
  @@index([status])
  @@index([plan])
}

/// A profile report ("signalement"): one user flags another. Reviewed and acted on by
/// admins from the "Signalements" section. Deleting either user removes their reports.
model Report {
  id      String       @id @default(cuid())
  reason  String
  details String?      @db.Text()
  status  ReportStatus @default(PENDING)

  reporter_id String
  reporter    User   @relation("ReportsMade", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported_id String
  reported    User   @relation("ReportsReceived", fields: [reported_id], references: [id], onDelete: Cascade)

  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([reported_id])
  @@index([reporter_id])
  @@index([status])
}

enum AiJobType {
  ANALYZE_VIDEO
  VERIFY_IDENTITY
  EMBED
  MATCH
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Durable AI job record. Redis Streams is the queue transport;
/// this table is the source of truth for status polling and audits.
model AiJob {
  id             String      @id @default(cuid())
  type           AiJobType
  status         AiJobStatus @default(QUEUED)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKey String?     @unique
  payload        Json
  result         Json?
  error          String?     @db.Text
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3)
  queuedAt       DateTime    @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, status])
}
